#!/bin/bash

readonly SELF_DIR=$(cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
if [ -f $SELF_DIR/wrapper_patch ]; then
   source $SELF_DIR/wrapper_patch
fi

cc="@CC@"
libc="@PREFIX@"
libc_inc="@INCDIR@"
libc_lib="@LIBDIR@"
wrapper_flags="@CLANG_WRAPPER_FLAGS@ $c_wrapper_flags"
thisdir="`cd "$(dirname "$0")"; pwd`"
static_libgcc=
linker=musl-clang

# prevent clang from running the linker (and erroring) on no input.
sflags=
eflags=
for x ; do
    case "$x" in
        # -r indicates that the output is an ordinary relocatable object file and 
        # thus we will not forward to the ld.musl-clang++ wrapper
        -r) linker=lld ;;
        -l*) input=1 ;;
        *) input= ;;
    esac
    if test "$input" ; then
        sflags="-l-user-start"
        eflags="-l-user-end"
        break
    fi
done

exec $cc \
    -Wno-unused-command-line-argument \
    -B"$thisdir" \
    -fuse-ld=$linker \
    -nostdlib \
    --sysroot "$libc" \
    -L-user-start \
    $wrapper_flags \
    $sflags \
    "$@" \
    $eflags \
    -L"$libc_lib" \
    -L-user-end
