#!/bin/bash

readonly SELF_DIR=$(cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
if [ -f $SELF_DIR/wrapper_patch ]; then
   source $SELF_DIR/wrapper_patch
fi

cc="@CC@"
ld="@LD@"
libc_lib="@LIBDIR@"
libcxx="@LIBCXXDIR@"
ldso="@LDSO@"
cleared=
shared=
userlinkdir=
userlink=
scrt="$libc_lib/Scrt1.o"
builtins_lib=

for x ; do
    test "$cleared" || set -- ; cleared=1

    case "$x" in
        -L-user-start)
            userlinkdir=1
            ;;
        -L-user-end)
            userlinkdir=
            ;;
        -L*)
            test "$userlinkdir" && set -- "$@" "$x"
            ;;
        -l-user-start)
            userlink=1
            ;;
        -l-user-end)
            userlink=
            ;;
        crtbegin*.o|crtend*.o)
            ;;
        -lgcc|-lgcc_eh)
            file=lib${x#-l}.a
            set -- "$@" $($cc -print-file-name=$file)
            ;;
        -l*)
            test "$userlink" && set -- "$@" "$x"
            ;;
        -shared)
            shared=1
            set -- "$@" -shared
            scrt=
            ;;
        -sysroot=*|--sysroot=*)
            ;;
        *)
            set -- "$@" "$x"
            ;;
    esac
done

if [ -f "$libcxx/lib/linux/libclang_rt.builtins-x86_64.a" ]; then
    builtins_lib="$libcxx/lib/linux/libclang_rt.builtins-x86_64.a"
fi

#exec $($cc -print-prog-name=ld) -nostdlib "$@" -lc -dynamic-linker "$ldso"
exec $ld \
-nostdlib \
$scrt \
"$@" \
-L$libc_lib \
-L$libcxx/lib/linux/ \
-rpath="$libc_lib:$libcxx/lib:$libcxx/lib/linux/" \
--as-needed $builtins_lib --no-as-needed \
-lc \
-dynamic-linker "$ldso"
